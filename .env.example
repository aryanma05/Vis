# Kopier til .env.local og fyll inn. .env.local skal aldri committes.

# Postgres. Lokalt: se README. På Vercel: legg til Neon under Storage,
# da settes DATABASE_URL automatisk.
DATABASE_URL=postgres://localhost:5432/vis
# Valgfri: direkte (ikke-pooled) Neon-URL som brukes til migreringer.
DATABASE_URL_UNPOOLED=

# Better Auth. Lag en hemmelighet med: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth-app (github.com/settings/developers).
# Callback-URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Påkrevd i produksjon: token for offentlige GitHub-data (import fra brukernavn/repo-lenke og
# repo-info på prosjektsidene). github.com/settings/personal-access-tokens → fine-grained med
# «Public repositories (read-only)» og lang utløpstid. Uten den deler appen GitHubs grense på
# 60 forespørsler i timen med alle andre på samme IP-adresse (hos Render er den alltid brukt opp).
GITHUB_TOKEN=

# Google OAuth-klient (console.cloud.google.com → Credentials).
# Redirect-URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kommaseparerte e-poster som er admin (moderering på /admin) når e-posten er bekreftet.
# I produksjon må admin også ha slått på to-trinns innlogging under Konto.
ADMIN_EMAILS=

# Headeren proxyen foran appen setter med klientens IP (brukes til grenser per IP).
# Tom = første verdi i X-Forwarded-For, som klienten kan forfalske bak noen proxyer.
# Se docs/sikkerhet/PRODUKSJONSSJEKKLISTE.md for hvordan du finner riktig verdi hos Render.
TRUSTED_IP_HEADER=

# Vercel Blob for bilder. Tom = bilder og CV-er lagres i databasen (serveres fra /filer/...).
BLOB_READ_WRITE_TOKEN=

# E-post for bekreftelse og nytt passord (se README). Tom lokalt = e-postene skrives
# til terminalen. Tom i produksjon = e-postbekreftelse er slått av.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Vises på /personvern.
CONTACT_EMAIL=

# Skjermbilder av prosjektlenker (lim inn en lenke når du deler et prosjekt).
# Tom = Microlink (microlink.io), gratis for 50 sider i døgnet uten nøkkel.
MICROLINK_API_KEY=
# Valgfri: sti til en Chrome/Chromium på serveren. Da tas bildene lokalt, uten grense.
# Under utvikling brukes Google Chrome automatisk for localhost-lenker hvis denne er tom.
# Eksempel på Mac: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
SCREENSHOT_BROWSER_PATH=

# Valgfri besøksstatistikk uten informasjonskapsler. Sett én av dem.
# Plausible: domenet slik det er registrert hos plausible.io (eller egen server via _SRC).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Umami: nettsted-ID fra cloud.umami.is (eller egen server via _SRC).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# Planlagte jobber. Lag en lang tilfeldig verdi (openssl rand -base64 32), og kall med
# headeren «Authorization: Bearer <CRON_SECRET>»:
#   https://<domenet>/api/cron/ukesoppsummering  hver time mandag kl. 07–10 (ukesoppsummeringen)
#   https://<domenet>/api/cron/daglig            én gang i døgnet (lagrede kandidatsøk, sletter gamle søknader)
CRON_SECRET=

# Betaling med Stripe (Pro for personer, Bedrift for bedrifter). Uten disse er betaling
# av, og Pro/Bedrift kan bare gis av admin. Bruk testnøkler (sk_test_…) til dere er klare.
#   1. dashboard.stripe.com → Developers → API keys → Secret key
STRIPE_SECRET_KEY=
#   2. Developers → Webhooks → Add endpoint: https://<domenet>/api/stripe/webhook med
#      hendelsene checkout.session.completed, customer.subscription.created,
#      customer.subscription.updated, customer.subscription.deleted og invoice.payment_failed.
#      Kopier «Signing secret» (whsec_…):
STRIPE_WEBHOOK_SECRET=
#   3. Product catalog → lag produktene «Vis Pro» (månedlig og årlig pris) og «Vis Bedrift»
#      (månedlig), og lim inn pris-ID-ene (price_…):
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
#   4. Settings → Billing → Customer portal: slå på oppsigelse og bytte av kort.

# --- API, webhooks og språk -----------------------------------------------------
# Trenger ingen egne variabler. API-nøkler lages av brukerne under Konto → Utviklere,
# webhooks av bedrifter med Bedrift-abonnement. Se README («API og webhooks», «Språk»).
